{
  "name": "sprachplaner-desktop",
  "productName": "Sprachplaner",
  "version": "1.0.0",
  "description": "Sprachplaner für Windows – Termine, To-dos und Listen",
  "author": "jonnybecker121-cmyk",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare:web": "node prepare.cjs",
    "start": "npm run prepare:web && electron .",
    "test": "node --test tests/*.test.cjs",
    "test:runtime": "node tests/runtime-runner.cjs",
    "pack": "npm run prepare:web && electron-builder --dir",
    "build:win": "npm run prepare:web && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "de.sprachplaner.desktop",
    "productName": "Sprachplaner",
    "artifactName": "Sprachplaner-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "assets.cjs",
      "web/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../www/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "de_DE",
        "en_US"
      ],
      "language": "1031"
    }
  }
}
